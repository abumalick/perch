+/* Fire a program status changed event. */
+static void
+input_fire_program_changed(struct window_pane *wp)
+{
+	struct event_payload	*ep;
+	struct cmd_find_state	 fs;
+
+	ep = event_payload_create();
+	cmd_find_from_pane(&fs, wp, 0);
+	event_payload_set_target(ep, &fs);
+	event_payload_set_pane(ep, "pane", wp);
+	event_payload_set_window(ep, "window", wp->window);
+	if (wp->program_state != NULL)
+		event_payload_set_string(ep, "program_state", "%s",
+		    wp->program_state);
+	if (wp->program_kind != NULL)
+		event_payload_set_string(ep, "program_kind", "%s",
+		    wp->program_kind);
+	if (wp->program_app != NULL)
+		event_payload_set_string(ep, "program_app", "%s",
+		    wp->program_app);
+	events_fire("pane-program-changed", ep);
+	server_status_window(wp->window);
+}
+
+/* Check a value is one of a comma-separated list of words. */
+static int
+input_osc_7501_one_of(const char *value, const char *list)
+{
+	size_t	len = strlen(value);
+
+	while (*list != '\0') {
+		if (strncmp(list, value, len) == 0 &&
+		    (list[len] == ',' || list[len] == '\0'))
+			return (1);
+		list = strchr(list, ',');
+		if (list == NULL)
+			break;
+		list++;
+	}
+	return (0);
+}
+
+/*
+ * Handle the OSC 7501 sequence (program status). Only the root record (no id)
+ * is kept; child records are ignored. A report that does not parse is
+ * discarded whole.
+ */
+static void
+input_osc_7501(struct input_ctx *ictx, const char *p)
+{
+	struct window_pane	*wp = ictx->wp;
+	static const char	 states[] = "idle,working,done,blocked,error";
+	static const char	 kinds[] = "permission,question,auth";
+	char			*copy, *next, *pair, *value;
+	const char		*state = NULL, *kind = NULL, *app = NULL;
+	const char		*end, *cp;
+	int			 child = 0, changed;
+
+	if (wp == NULL)
+		return;
+
+	if (strcmp(p, "?") == 0) {
+		if (ictx->input_end == INPUT_END_BEL)
+			end = "\007";
+		else
+			end = "\033\\";
+		input_reply(ictx, 1, "\033]7501;?:states=%s:kinds=%s%s", states,
+		    kinds, end);
+		return;
+	}
+
+	copy = next = xstrdup(p);
+	while ((pair = strsep(&next, ":")) != NULL) {
+		value = strchr(pair, '=');
+		if (value == NULL)
+			goto out;
+		*value++ = '\0';
+		if (strcmp(pair, "state") == 0)
+			state = value;
+		else if (strcmp(pair, "kind") == 0)
+			kind = value;
+		else if (strcmp(pair, "app") == 0)
+			app = value;
+		else if (strcmp(pair, "id") == 0 && *value != '\0')
+			child = 1;
+	}
+	if (state == NULL || child)
+		goto out;
+
+	if (strcmp(state, "clear") == 0)
+		changed = window_pane_set_program_status(wp, NULL, NULL, NULL);
+	else {
+		if (!input_osc_7501_one_of(state, states))
+			goto out;
+		if (kind != NULL && (strcmp(state, "blocked") != 0 ||
+		    !input_osc_7501_one_of(kind, kinds)))
+			kind = NULL;
+		if (app != NULL) {
+			if (*app == '\0' || strlen(app) > 32)
+				goto out;
+			for (cp = app; *cp != '\0'; cp++) {
+				if (*cp <= ' ' || *cp > '~')
+					goto out;
+			}
+		}
+		changed = window_pane_set_program_status(wp, state, kind, app);
+	}
+	if (changed)
+		input_fire_program_changed(wp);
+
+out:
+	free(copy);
+}
+
 /* Handle the OSC 133 sequence. */
 static void
 input_osc_133(struct input_ctx *ictx, const char *p)
@@ -3416,6 +3539,8 @@ input_osc_133(struct input_ctx *ictx, const char *p)
 		if (wp != NULL) {
 			wp->last_prompt_time = time(NULL);
 			events_fire_pane("pane-shell-prompt", wp);
+			if (window_pane_drop_program_status(wp))
+				input_fire_program_changed(wp);
 		}
 		break;
 	case 'P':
