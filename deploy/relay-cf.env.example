# Cloudflare relay. Copy to deploy/relay-cf.env in the main checkout, which is gitignored;
# deploy/relay-cf-deploy.sh reads it from there wherever it runs.
# Everything account- or host-specific lives here and nowhere in the repo; the runbook
# (docs/relay-cf-runbook.md) refers to these names instead of the values.

# The Cloudflare account wrangler deploys to (wrangler also reads it from the environment).
CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
# The relay's custom domain, in a zone on the same Cloudflare account. When set, every production
# deploy attaches it (Cloudflare creates the DNS record and certificate) and turns the
# workers.dev host off, so the domain is the relay's only host and the zone's rate-limiting rule
# sees every request. Phones and agents use it.
# RELAY_DOMAIN=relay.example.com
# Without a custom domain the relay answers on its workers.dev host only, which no zone rule can
# cover: the host `wrangler deploy` printed (<worker>.<subdomain>.workers.dev).
# RELAY_HOST=perch-relay.example.workers.dev
# The relay's join key, uploaded as the JOIN_KEY secret: 32 random bytes, base64url, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# A machine joins with `PERCH_JOIN_KEY=<this> pnpm perch connect wss://<RELAY_DOMAIN>`. Required
# for a production deploy. Secret.
RELAY_JOIN_KEY=replace-with-32-random-bytes-base64url
# The operator's admin key, uploaded as the ADMIN_KEY secret: another 32 random bytes, made the
# same way. It lists and removes machines (`PERCH_ADMIN_KEY=<this> pnpm perch-relay machines list
# --url wss://<RELAY_DOMAIN>`); the join key cannot. Unset, those answer 501. Secret.
RELAY_ADMIN_KEY=replace-with-32-random-bytes-base64url
# The throwaway dev Worker's own keys (`relay-cf-deploy.sh --dev`), made like the two above and
# never equal to them: a dev deploy refuses to run without RELAY_DEV_JOIN_KEY and never uploads
# production's keys. Secret.
# RELAY_DEV_JOIN_KEY=replace-with-32-random-bytes-base64url
# RELAY_DEV_ADMIN_KEY=replace-with-32-random-bytes-base64url
