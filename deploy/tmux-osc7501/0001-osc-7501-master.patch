+/* Replace a program status string, returning 1 if it changed. */
+static int
+window_pane_replace_program_string(char **field, const char *value)
+{
+	if (*field == NULL && value == NULL)
+		return (0);
+	if (*field != NULL && value != NULL && strcmp(*field, value) == 0)
+		return (0);
+	free(*field);
+	*field = (value == NULL ? NULL : xstrdup(value));
+	return (1);
+}
+
+/*
+ * Set the program status (OSC 7501 root record) of a pane, or clear it if
+ * state is NULL. Returns 1 if anything changed.
+ */
+int
+window_pane_set_program_status(struct window_pane *wp, const char *state,
+    const char *kind, const char *app)
+{
+	int	changed = 0;
+
+	if (state == NULL)
+		kind = app = NULL;
+	changed |= window_pane_replace_program_string(&wp->program_state, state);
+	changed |= window_pane_replace_program_string(&wp->program_kind, kind);
+	changed |= window_pane_replace_program_string(&wp->program_app, app);
+	if (changed)
+		wp->program_time = (state == NULL ? 0 : time(NULL));
+	return (changed);
+}
+
+/*
+ * Drop a working or blocked program status, which is stale once the program
+ * exits or a new shell prompt starts. Returns 1 if it was dropped.
+ */
+int
+window_pane_drop_program_status(struct window_pane *wp)
+{
+	if (wp->program_state == NULL)
+		return (0);
+	if (strcmp(wp->program_state, "working") != 0 &&
+	    strcmp(wp->program_state, "blocked") != 0)
+		return (0);
+	return (window_pane_set_program_status(wp, NULL, NULL, NULL));
+}
+
 /* Prompt input callback. */
 static enum prompt_result
 window_pane_prompt_input_callback(void *data, const char *s,
