# Copy to deploy/pwa-deploy.env (gitignored) in the main checkout. The account, and a command that
# prints a Cloudflare API token scoped to Workers Scripts:Edit on it. deploy/pwa-deploy.sh runs the
# command for each deploy and hands the token to wrangler alone; without it, nothing is deployed.
CLOUDFLARE_ACCOUNT_ID=
PWA_DEPLOY_TOKEN_CMD='bw get password "<Bitwarden item>"'
