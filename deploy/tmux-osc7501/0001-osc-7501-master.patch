+{
+	if (ft->wp != NULL && ft->wp->program_state != NULL)
+		return (xstrdup(ft->wp->program_state));
+	return (NULL);
+}
+
+/* Callback for pane_program_time. */
+static void *
+format_cb_pane_program_time(struct format_tree *ft)
+{
+	struct window_pane	*wp = ft->wp;
+	static struct timeval	 tv;
+
+	if (wp != NULL && wp->program_time != 0) {
+		tv.tv_sec = wp->program_time;
+		tv.tv_usec = 0;
+		return (&tv);
+	}
+	return (NULL);
+}
