# Copy to deploy/agent.env and fill in. deploy/agent.env is gitignored.
# A strong random token, e.g. `openssl rand -hex 32`. It authenticates Claude Code's hooks to the
# agent's loopback /hooks endpoint, and enrols a phone by token while token enrolment is on
# (`perch devices enrolment on`); a paired phone never holds it.
PERCH_TOKEN=replace-with-openssl-rand-hex-32
# Unique per machine (e.g. "mac" or "mini")
PERCH_MACHINE_ID=mac
# Colon-separated project roots offered for new workspaces
PERCH_PROJECT_ROOTS=/Users/you/workspace
# The loopback port Claude Code's hooks post to (install-hooks bakes it in). The agent listens on
# 127.0.0.1 only; phones reach it through the relays below, never on this port.
PERCH_PORT=8787
# Relays: the agent serves phones through each of them, and only through them, end-to-end encrypted,
# holding one control socket per relay. Base URLs only; the account comes from
# ~/.perch/relay-key.json (`perch relay-key` creates it and prints the phone/relay values), so it
# is the same on every relay. PERCH_RELAY_URLS takes several, comma- or space-separated.
# The older single PERCH_RELAY_URL is no longer read (the agent warns at startup if it is set).
# See docs/relay-cf-runbook.md.
# PERCH_RELAY_URLS=wss://relay.example.com,ws://127.0.0.1:8450
# `pnpm perch connect <relay>` adds a relay here for you (after a backup). It takes the relay's
# join key from PERCH_JOIN_KEY in its environment (or --key, which the process list shows); the
# join key is not read from this file.
# Where phones open the PWA: the origin of the pairing links `perch pair` prints.
# PERCH_PWA_ORIGIN=https://pwa.example:8443
# Optional: the default path a pairing link gives a new phone entry, which relative New-workspace
# paths resolve against. Absolute (no ~), at most 128 characters; without it the link carries none.
# PERCH_DEFAULT_PATH=/Users/you/workspace
# Optional: the dictation vocabulary file (default ~/.perch/keyterms.txt).
# PERCH_KEYTERMS_PATH=/path/to/keyterms.txt
