 input.c         | 125 ++++++++++++++++++++++++++++++++++++++++++++++++
 options-table.c |   3 ++
 server-fn.c     |   1 +
 tmux.1          |  10 ++++
 tmux.h          |   8 ++++
 window.c        |  51 ++++++++++++++++++++
 7 files changed, 252 insertions(+)

